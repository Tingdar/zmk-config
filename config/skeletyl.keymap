
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y       &kp U       &kp I       &kp O       &kp P

                &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F &kp G
                &kp H       &hm RSHFT J &hm RGUI K  &hm RALT L  &hm RCTRL SEMI

                &kp Z       &kp X       &kp C       &kp V       &kp B
                &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH

                &kp LGUI    &kp SPACE   &kp LALT
                &kp RALT    &kp RET     &kp RGUI
            >;
        };
    };
};
