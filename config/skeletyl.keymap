#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY + home-row mods
        default_layer {
            bindings = <
                &kp Q      &kp W       &kp E       &kp R       &kp T
                &kp Y      &kp U       &kp I       &kp O       &kp P

                &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F &kp G
                &kp H       &hm RSHFT J &hm RGUI K  &hm RALT L &hm RCTRL SEMI

                &kp Z       &kp X       &kp C       &kp V   &kp B
                &kp N       &kp M       &kp COMMA   &kp DOT &kp FSLH

                &mo 1       &kp BSPC    &kp TAB
                &kp RET     &kp SPC     &mo 2
            >;
        };

        // Layer 1: Lower - symbols and navigation
        lower_layer {
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT
                &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR

                &kp LEFT    &kp UP      &kp DOWN    &kp RIGHT &kp INS
                &kp EQUAL  &kp BSLH    &kp MINUS   &kp LBKT    &kp RBKT

                &kp HOME    &kp PG_UP   &kp PG_DN   &kp END     &kp SLCK
                &kp PLUS   &kp PIPE    &kp UNDER   &kp LBRC    &kp RBRC

                &none     &kp DEL       &kp ESC
                &kp DQT   &kp SQT      &mo 3
            >;
        };

        // Layer 2: Raise - function keys and numpad
        raise_layer {
            bindings = <
                &kp F1      &kp F2      &kp F3      &kp F4  &none
                &kp KP_NLCK &kp KP_N7   &kp KP_N8   &kp KP_N9   &kp KP_MULTIPLY

                &kp F5      &kp F6      &kp F7      &kp F8  &none
                &kp KP_MINUS  &kp KP_N4   &kp KP_N5   &kp KP_N6   &kp KP_DIVIDE

                &kp F9      &kp F10     &kp F11     &kp F12 &none
                &kp KP_N0   &kp KP_N1   &kp KP_N2   &kp KP_N3   &kp KP_PLUS

                &mo 3     &none      &none
                &none     &mo 4       &none
            >;
        };

        // Layer 3: Numbers
        numbers_layer {
            bindings = <
                &kp N1     &kp N2      &kp N3      &kp N4      &kp N5
                &kp N6     &kp N7      &kp N8      &kp N9      &kp N0

                &none      &none       &none       &none       &none
                &none      &none       &none       &none       &none

                &none      &none       &none       &none       &none
                &none      &none       &none       &none       &none

                &none      &none       &none
                &none      &none       &none
            >;
        };

        // Layer 4: Bluetooth and firmware tools
        BLE_layer {
            bindings = <
                &bootloader &none    &none       &none       &none
                &none       &none    &none       &none       &bootloader

                &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &bt BT_CLR      &none           &none           &none           &none

                &none       &none       &none       &none       &none
                &none       &none       &none       &none       &none

                &none       &none       &none
                &none       &none       &none
            >;
        };
    };
};
